# Base
color-link default                 ",default"

# UI
color-link statusline              "black,red"
color-link statusline.inactive     "brightblack,default"
color-link tabbar                  "brightblack,default"
color-link tabbar.active           "black,red"
color-link line-number             "brightblack,"
color-link current-line-number     "red,"
color-link selection               "black,red"
color-link hlsearch                "black,red"
color-link match-brace             "cyan,"
color-link message                 "white,"
color-link error-message           "red,"
color-link indent-char             "brightblack,"
color-link trailingws              "red,"

# Sintaxis
color-link comment                 "brightblack,"
color-link statement               "red,"
color-link type                    "cyan,"
color-link type.keyword            "cyan,"
color-link identifier              "white,"
color-link identifier.class        "cyan,"
color-link identifier.var          "white,"
color-link constant.string         "white,"
color-link constant.number         "cyan,"
color-link constant.bool.true      "cyan,"
color-link constant.bool.false     "red,"
color-link constant.specialChar    "brightred,"
color-link special                 "brightred,"
color-link preproc                 "brightblack,"
color-link preproc.shebang         "brightblack,"
color-link symbol.operator         "white,"
color-link error                   "red,"
color-link todo                    "brightred,"

# Git / diff
color-link diff-added              "green,"
color-link diff-modified           "brightred,"
color-link diff-deleted            "red,"
color-link gutter-info             "cyan,"
color-link gutter-error            "red,"
color-link gutter-warning          "brightred,"
